{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nyxa:unified-room:v0.1:task",
  "title": "NYXA Governed Task V0.1",
  "description": "DRAFT, SOURCE-BOUND (Implementation Handoff 2026-11-07). Generated by Claude Code for Johannes Süß.",
  "type": "object",
  "required": ["task_id", "created_by", "requested_by", "executor", "task_type", "scope", "scope_hash", "context_refs", "execution_mode", "approval_status", "status", "idempotency_key", "correlation_id", "created_at"],
  "properties": {
    "task_id": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
    "created_by": { "type": "string" },
    "requested_by": { "type": "string" },
    "executor": { "type": "string" },
    "task_type": { "type": "string" },
    "scope": {
      "type": "object",
      "required": ["resources", "allowed_operations"],
      "properties": {
        "resources": { "type": "array", "items": { "type": "string" } },
        "allowed_operations": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "scope_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "context_refs": { "type": "array" },
    "instruction_ref": { "type": ["string", "null"] },
    "execution_mode": { "enum": ["DIRECT", "ON_APPROVAL", "HOURLY", "DAILY", "MANUAL", "PAUSED", "UNKNOWN"] },
    "approval_required": { "type": "boolean" },
    "approval_status": { "enum": ["pending", "approved", "denied", "revoked"] },
    "status": { "enum": ["PROPOSED", "PENDING_APPROVAL", "APPROVED", "CLAIMED", "RUNNING", "RESULT_RECORDED", "VERIFIED", "COMPLETED", "DENIED", "CANCELLED", "FAILED", "EXPIRED", "ESCALATED"] },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string" },
    "cost_budget_cents": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
