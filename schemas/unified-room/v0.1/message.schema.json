{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nyxa:unified-room:v0.1:message",
  "title": "NYXA Unified Room Message V0.1",
  "description": "DRAFT, SOURCE-BOUND (Implementation Handoff 2026-11-07). Generated by Claude Code for Johannes Süß.",
  "type": "object",
  "required": ["message_id", "conversation_id", "actor_id", "channel", "timestamp", "content_ref", "delivery_status", "visibility", "provenance", "trust"],
  "properties": {
    "message_id": { "type": "string", "minLength": 1 },
    "conversation_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": ["string", "null"] },
    "actor_id": { "type": "string", "minLength": 1 },
    "actor_kind": { "enum": ["human", "agent", "external", "system"] },
    "channel": { "enum": ["text", "voice", "agent", "mail", "system"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "content_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "delivery_status": { "enum": ["COMMITTED", "PENDING", "DELIVERED", "ACKED", "FAILED"] },
    "visibility": { "enum": ["room", "private", "operator"] },
    "provenance": { "type": "object" },
    "correlation_id": { "type": ["string", "null"] },
    "trust": { "enum": ["trusted_principal", "untrusted_external"] },
    "seq": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": true
}
