# Copy to .env (never commit .env). The key comes from https://dev.runway.com (Manage -> API keys).
RUNWAYML_API_SECRET=

# Optional: ID (uuid) of a custom Character created in the Developer Portal.
# If set, the server uses only this Character and ignores preset selection.
RUNWAY_AVATAR_ID=

# Optional: server port (default 3000).
PORT=3000
