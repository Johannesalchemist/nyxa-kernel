# Copy to .env (never commit .env). All values below are examples or safe defaults.
# Runway key: https://dev.runway.com (Manage -> API keys). Server-side only.
RUNWAYML_API_SECRET=

# Local access token (>= 32 random chars), e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Without it, no session can be created (fail closed).
NYXA_ACCESS_TOKEN=

# Capability grant. Without it every session request is DENIED by the policy gate.
NYXA_GRANTED_CAPABILITIES=runway.realtime_session.create

# Total local credit budget (estimate, 1 credit = 0.01 USD per Runway price list 2026-11-06).
# 0 = no paid session possible. One 120 s session reserves 42 credits.
RUNWAY_BUDGET_CREDITS=0

# Hard per-session cap sent to Runway (10..600 s). Default 120.
RUNWAY_MAX_DURATION_S=120
MAX_CONCURRENT_SESSIONS=1
# Max session creations per window.
SESSION_CREATE_LIMIT=3
SESSION_CREATE_WINDOW_S=600

# Optional: uuid of a custom Character. If set, only this Character is used.
RUNWAY_AVATAR_ID=
# Optional: restrict presets (comma separated, documented IDs only).
# ALLOWED_PRESETS=influencer,cooking-teacher

# Delete transcript + recording at Runway after each session (irreversible, not live-tested).
RUNWAY_DELETE_CONVERSATION_AFTER_END=false

# Operating context; contexts listed in NYXA_ESCALATION_CONTEXTS are always blocked (ESCALATE).
NYXA_OPERATING_CONTEXT=
# NYXA_ESCALATION_CONTEXTS=pilot:schule-in-der-hosentasche,audience:minors

# Network: loopback only by default. A non-loopback HOST requires ALLOW_REMOTE_BIND=true and a token.
HOST=127.0.0.1
PORT=3000
# ALLOWED_HOSTS=
# COOKIE_SECURE=false

# Lifecycle timers (seconds)
# CONNECT_GRACE_S=30
# HEARTBEAT_TIMEOUT_S=45
# PROVISION_TIMEOUT_S=60

# Ledger, lock and audit trail (git-ignored)
NYXA_STATE_DIR=.state
